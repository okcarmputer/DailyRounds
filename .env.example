# Hostnames/DB names confirmed against flow_monitor/src/data_import/properties.json,
# missionscrape/cfg/mission_properties.json, and OPC-UA-Client/opcua_logger/config/
# mission_properties.json — dev is DEV-SQL-00-IG (not DEV-SQL-00), and both dev/prod
# databases are actually named "flow_monitor" lowercase in every config found (SQL
# Server names are case-insensitive by default, so this is cosmetic either way).
# TrustServerCertificate=yes is required — ODBC Driver 18 defaults to strict TLS
# cert verification (driver 17 didn't), and these internal SQL Servers use
# self-signed certs. Without it, pyodbc.connect() fails with:
#   SSL Provider: [error:0A000086:SSL routines::certificate verify failed:self-signed certificate]
DEV_SQL_CONN_STRING=Driver={ODBC Driver 18 for SQL Server};Server=DEV-SQL-00-IG;Database=flow_monitor;Uid=...;Pwd=...;TrustServerCertificate=yes
PROD_SQL_CONN_STRING=Driver={ODBC Driver 18 for SQL Server};Server=sv-dg-p00-sql;Database=flow_monitor;Uid=...;Pwd=...;TrustServerCertificate=yes
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
SMTP_TO=carmellah@re-wa.org
